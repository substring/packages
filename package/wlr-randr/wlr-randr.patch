+// Removes the custom modes requested with --rmmode, returns false on error
+static bool remove_modes(struct randr_state *state, struct wl_display *display) {
+	bool ok = true;
+	struct randr_head *head;
+	wl_list_for_each(head, &state->heads, link) {
+		if (head->remove_mode_name == NULL) {
+			continue;
+		}
+
+		struct randr_mode *mode, *found = NULL;
+		wl_list_for_each(mode, &head->modes, link) {
+			if (mode->name != NULL && strcmp(mode->name, head->remove_mode_name) == 0) {
+				found = mode;
+				break;
+			}
+		}
+		if (found == NULL) {
+			fprintf(stderr, "unknown mode %s on %s\n", head->remove_mode_name, head->name);
+			ok = false;
+			continue;
+		}
+		if (found == head->mode) {
+			fprintf(stderr, "mode %s is in use on %s\n", head->remove_mode_name, head->name);
+			ok = false;
+			continue;
+		}
+
+		zwlr_output_head_v1_remove_custom_mode(head->wlr_head, found->wlr_mode);
+		if (wl_display_roundtrip(display) < 0) {
+			return false;
+		}
+
+		// The compositor finishes the mode on success
+		wl_list_for_each(mode, &head->modes, link) {
+			if (mode == found) {
+				fprintf(stderr, "the compositor kept mode %s on %s\n",
+					head->remove_mode_name, head->name);
+				ok = false;
+				break;
+			}
+		}
+	}
+	return ok;
+}
