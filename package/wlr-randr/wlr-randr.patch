+// [name] <clock MHz> <hdisplay> <hsync_start> <hsync_end> <htotal>
+// <vdisplay> <vsync_start> <vsync_end> <vtotal> [+hsync|-hsync]
+// [+vsync|-vsync] [interlace] [doublescan], like xrandr --newmode
+static bool parse_modeline(const char *value, struct randr_timings *t,
+		char *name, size_t name_size) {
+	char *copy = strdup(value);
+	char *save = NULL;
+	char *tok = strtok_r(copy, " \t", &save);
+	name[0] = '\0';
+
+	char *end = NULL;
+	if (tok != NULL) {
+		strtod(tok, &end);
+	}
+	if (tok != NULL && (end == tok || end[0] != '\0')) {
+		// Leading name, quotes are optional
+		size_t len = strlen(tok);
+		if (len >= 2 && tok[0] == '"' && tok[len - 1] == '"') {
+			tok[len - 1] = '\0';
+			tok++;
+		}
+		snprintf(name, name_size, "%s", tok);
+		tok = strtok_r(NULL, " \t", &save);
+	}
+
+	uint32_t *fields[] = {
+		&t->hdisplay, &t->hsync_start, &t->hsync_end, &t->htotal,
+		&t->vdisplay, &t->vsync_start, &t->vsync_end, &t->vtotal,
+	};
+	bool ok = tok != NULL;
+	if (ok) {
+		double clock = strtod(tok, &end);
+		ok = end != tok && end[0] == '\0' && clock > 0;
+		t->clock = round(clock * 1000); // MHz → kHz
+	}
+	for (size_t i = 0; ok && i < sizeof(fields) / sizeof(fields[0]); i++) {
+		tok = strtok_r(NULL, " \t", &save);
+		ok = tok != NULL;
+		if (ok) {
+			long v = strtol(tok, &end, 10);
+			ok = end != tok && end[0] == '\0' && v >= 0;
+			*fields[i] = v;
+		}
+	}
+
+	t->flags = 0;
+	while (ok && (tok = strtok_r(NULL, " \t", &save)) != NULL) {
+		if (strcasecmp(tok, "+hsync") == 0) {
+			t->flags |= ZWLR_OUTPUT_MODE_V1_TIMING_FLAGS_PHSYNC;
+		} else if (strcasecmp(tok, "-hsync") == 0) {
+			t->flags |= ZWLR_OUTPUT_MODE_V1_TIMING_FLAGS_NHSYNC;
+		} else if (strcasecmp(tok, "+vsync") == 0) {
+			t->flags |= ZWLR_OUTPUT_MODE_V1_TIMING_FLAGS_PVSYNC;
+		} else if (strcasecmp(tok, "-vsync") == 0) {
+			t->flags |= ZWLR_OUTPUT_MODE_V1_TIMING_FLAGS_NVSYNC;
+		} else if (strcasecmp(tok, "interlace") == 0) {
+			t->flags |= ZWLR_OUTPUT_MODE_V1_TIMING_FLAGS_INTERLACE;
+		} else if (strcasecmp(tok, "doublescan") == 0) {
+			t->flags |= ZWLR_OUTPUT_MODE_V1_TIMING_FLAGS_DBLSCAN;
+		} else {
+			fprintf(stderr, "invalid modeline flag: %s\n", tok);
+			ok = false;
+		}
+	}
+	free(copy);
+
+	if (ok && (t->hdisplay == 0 || t->vdisplay == 0 ||
+			t->hdisplay > t->hsync_start || t->hsync_start > t->hsync_end ||
+			t->hsync_end > t->htotal || t->vdisplay > t->vsync_start ||
+			t->vsync_start > t->vsync_end || t->vsync_end > t->vtotal)) {
+		fprintf(stderr, "invalid modeline: inconsistent timings: %s\n", value);
+		return false;
+	}
+	if (!ok) {
+		fprintf(stderr, "invalid modeline: %s\n", value);
+	}
+	return ok;
+}
