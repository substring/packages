 		screen_pos = m_device_name[0] - '0';
 
+	int lease_fd = -1;
+	struct stat lease_st = {};
+#ifdef SR_WITH_DRM_LEASE
+	// Under a Wayland compositor, which is the DRM master, lease the connector
+	if (getenv("WAYLAND_DISPLAY") != nullptr)
