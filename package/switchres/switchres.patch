 drm_lease.cpp              | 236 +++++++++++++++++++++++++++
 drm_lease.h                |  72 +++++++++
 makefile                   |   8 +
 protocols/drm-lease-v1.xml | 317 +++++++++++++++++++++++++++++++++++++
 6 files changed, 692 insertions(+), 1 deletion(-)
 create mode 100644 drm_lease.cpp
 create mode 100644 drm_lease.h
 create mode 100644 protocols/drm-lease-v1.xml

