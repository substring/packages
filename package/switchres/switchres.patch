+
+// Wayland compositors own the display: modes are set by asking the
+// compositor through the wlr-output-management protocol. Version 5 of the
+// protocol carries full timings (modelines), older versions only allow
+// width x height @ refresh, leaving the timings to the compositor.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <poll.h>
+#include <wayland-client.h>
+#include "wlr-output-management-unstable-v1-client-protocol.h"
+
+#include "custom_video_wayland.h"
+#include "log.h"
+
+#define WAYLAND_TIMINGS_VERSION 5
+#define WAYLAND_MAX_VERSION 5
+
+// DRM_MODE_FLAG_* values, mirrored by zwlr_output_mode_v1.timing_flags
+#define WL_FLAG_PHSYNC    0x01
+#define WL_FLAG_NHSYNC    0x02
+#define WL_FLAG_PVSYNC    0x04
+#define WL_FLAG_NVSYNC    0x08
+#define WL_FLAG_INTERLACE 0x10
+#define WL_FLAG_DBLSCAN   0x20
+
+enum
+{
+	CONFIG_PENDING = 0,
+	CONFIG_SUCCEEDED,
+	CONFIG_FAILED,
+	CONFIG_CANCELLED
+};
+
+static wayland_timing *self(void *data) { return (wayland_timing *)data; }
+
+//============================================================
+//  Protocol listeners
+//============================================================
+
+// zwlr_output_mode_v1
+
+static void mode_size(void *data, zwlr_output_mode_v1 *, int32_t width, int32_t height)
+{
+	wayland_mode *m = (wayland_mode *)data;
+	m->width = width;
+	m->height = height;
+}
+
+static void mode_refresh(void *data, zwlr_output_mode_v1 *, int32_t refresh)
+{
+	((wayland_mode *)data)->refresh = refresh;
+}
+
+static void mode_preferred(void *data, zwlr_output_mode_v1 *)
+{
+	((wayland_mode *)data)->preferred = true;
+}
+
+static void mode_finished(void *data, zwlr_output_mode_v1 *);
+
+static void mode_timings(void *data, zwlr_output_mode_v1 *, uint32_t clock,
+	uint32_t hdisplay, uint32_t hsync_start, uint32_t hsync_end, uint32_t htotal,
+	uint32_t vdisplay, uint32_t vsync_start, uint32_t vsync_end, uint32_t vtotal, uint32_t flags)
+{
+	wayland_mode *m = (wayland_mode *)data;
+	m->has_timings = true;
+	m->timings = { clock, hdisplay, hsync_start, hsync_end, htotal, vdisplay, vsync_start, vsync_end, vtotal, flags };
+}
+
+static const zwlr_output_mode_v1_listener mode_listener =
+{
+	mode_size,
+	mode_refresh,
+	mode_preferred,
+	mode_finished,
+	mode_timings,
+};
+
+// zwlr_output_head_v1, user data is the wayland_head, the backend is reached through the manager
+
+static wayland_timing *s_instance = nullptr;
+
+static void head_name(void *data, zwlr_output_head_v1 *, const char *name)
+{
+	((wayland_head *)data)->name = name;
+}
+
+static void head_description(void *, zwlr_output_head_v1 *, const char *) {}
+static void head_physical_size(void *, zwlr_output_head_v1 *, int32_t, int32_t) {}
+
+static void head_mode(void *data, zwlr_output_head_v1 *, zwlr_output_mode_v1 *mode)
+{
+	s_instance->on_mode((wayland_head *)data, mode);
+}
+
+static void head_enabled(void *data, zwlr_output_head_v1 *, int32_t enabled)
+{
+	wayland_head *h = (wayland_head *)data;
+	h->enabled = enabled;
+	if (!enabled)
+		h->current_mode = nullptr;
+}
+
+static void head_current_mode(void *data, zwlr_output_head_v1 *, zwlr_output_mode_v1 *mode)
+{
+	wayland_head *h = (wayland_head *)data;
+	h->current_mode = (wayland_mode *)zwlr_output_mode_v1_get_user_data(mode);
+}
+
+static void head_position(void *data, zwlr_output_head_v1 *, int32_t x, int32_t y)
+{
+	wayland_head *h = (wayland_head *)data;
+	h->x = x;
+	h->y = y;
+}
+
+static void head_transform(void *data, zwlr_output_head_v1 *, int32_t transform)
+{
+	((wayland_head *)data)->transform = transform;
+}
+
+static void head_scale(void *data, zwlr_output_head_v1 *, wl_fixed_t scale)
+{
+	((wayland_head *)data)->scale = wl_fixed_to_double(scale);
+}
+
+static void head_finished(void *data, zwlr_output_head_v1 *)
+{
+	s_instance->on_head_finished((wayland_head *)data);
+}
+
+static void head_make(void *, zwlr_output_head_v1 *, const char *) {}
+static void head_model(void *, zwlr_output_head_v1 *, const char *) {}
+static void head_serial_number(void *, zwlr_output_head_v1 *, const char *) {}
+static void head_adaptive_sync(void *, zwlr_output_head_v1 *, uint32_t) {}
+
+static const zwlr_output_head_v1_listener head_listener =
+{
+	head_name,
+	head_description,
+	head_physical_size,
+	head_mode,
+	head_enabled,
+	head_current_mode,
+	head_position,
+	head_transform,
+	head_scale,
+	head_finished,
+	head_make,
+	head_model,
+	head_serial_number,
+	head_adaptive_sync,
+};
+
+static void mode_finished(void *data, zwlr_output_mode_v1 *)
+{
+	s_instance->on_mode_finished((wayland_mode *)data);
+}
+
+// zwlr_output_manager_v1
+
+static void manager_head(void *data, zwlr_output_manager_v1 *, zwlr_output_head_v1 *head)
+{
+	self(data)->on_head(head);
+}
+
+static void manager_done(void *data, zwlr_output_manager_v1 *, uint32_t serial)
+{
+	self(data)->on_done(serial);
+}
+
+static void manager_finished(void *, zwlr_output_manager_v1 *) {}
+
+static const zwlr_output_manager_v1_listener manager_listener =
+{
+	manager_head,
+	manager_done,
+	manager_finished,
+};
+
+// zwlr_output_configuration_v1
+
+static void config_succeeded(void *data, zwlr_output_configuration_v1 *)
+{
+	self(data)->on_config_result(CONFIG_SUCCEEDED);
+}
+
+static void config_failed(void *data, zwlr_output_configuration_v1 *)
+{
+	self(data)->on_config_result(CONFIG_FAILED);
+}
+
+static void config_cancelled(void *data, zwlr_output_configuration_v1 *)
+{
+	self(data)->on_config_result(CONFIG_CANCELLED);
+}
+
+static const zwlr_output_configuration_v1_listener config_listener =
+{
+	config_succeeded,
+	config_failed,
+	config_cancelled,
+};
+
+// wl_registry
+
+static void registry_global(void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+	self(data)->on_global(registry, name, interface, version);
+}
+
+static void registry_global_remove(void *, wl_registry *, uint32_t) {}
+
+static const wl_registry_listener registry_listener =
+{
+	registry_global,
+	registry_global_remove,
+};
+
+//============================================================
+//  Helpers
+//============================================================
+
+static void modeline_to_timings(modeline *mode, wl_timings *t)
+{
+	t->clock       = mode->pclock / 1000;
+	t->hdisplay    = mode->hactive;
+	t->hsync_start = mode->hbegin;
+	t->hsync_end   = mode->hend;
+	t->htotal      = mode->htotal;
+	t->vdisplay    = mode->vactive;
+	t->vsync_start = mode->vbegin;
+	t->vsync_end   = mode->vend;
+	t->vtotal      = mode->vtotal;
+	t->flags       = (mode->interlace ? WL_FLAG_INTERLACE : 0) | (mode->doublescan ? WL_FLAG_DBLSCAN : 0) |
+	                 (mode->hsync ? WL_FLAG_PHSYNC : WL_FLAG_NHSYNC) | (mode->vsync ? WL_FLAG_PVSYNC : WL_FLAG_NVSYNC);
+}
+
+static bool same_timings(const wl_timings *a, const wl_timings *b)
+{
+	return a->clock == b->clock &&
+		a->hdisplay == b->hdisplay && a->hsync_start == b->hsync_start && a->hsync_end == b->hsync_end && a->htotal == b->htotal &&
+		a->vdisplay == b->vdisplay && a->vsync_start == b->vsync_start && a->vsync_end == b->vsync_end && a->vtotal == b->vtotal &&
+		(a->flags & (WL_FLAG_INTERLACE | WL_FLAG_DBLSCAN)) == (b->flags & (WL_FLAG_INTERLACE | WL_FLAG_DBLSCAN)) &&
+		((a->flags & WL_FLAG_PHSYNC) != 0) == ((b->flags & WL_FLAG_PHSYNC) != 0) &&
+		((a->flags & WL_FLAG_PVSYNC) != 0) == ((b->flags & WL_FLAG_PVSYNC) != 0);
+}
+
+//============================================================
+//  wayland_timing::wayland_timing
+//============================================================
+
+wayland_timing::wayland_timing(char *device_name, custom_video_settings *vs)
+{
+	m_vs = *vs;
+	strncpy(m_device_name, device_name, sizeof(m_device_name) - 1);
+	m_device_name[sizeof(m_device_name) - 1] = 0;
+}
+
+//============================================================
+//  wayland_timing::~wayland_timing
+//============================================================
+
+wayland_timing::~wayland_timing()
+{
+	for (auto head : m_heads)
+	{
+		for (auto mode : head->modes)
+		{
+			zwlr_output_mode_v1_destroy(mode->obj);
+			delete mode;
+		}
+		zwlr_output_head_v1_destroy(head->obj);
+		delete head;
+	}
+	m_heads.clear();
+
+	if (m_manager)
+		zwlr_output_manager_v1_destroy(m_manager);
+	if (m_registry)
+		wl_registry_destroy(m_registry);
+	if (m_display)
+		wl_display_disconnect(m_display);
+
+	if (s_instance == this)
+		s_instance = nullptr;
+}
+
+//============================================================
+//  wayland_timing::init
+//============================================================
+
+bool wayland_timing::init()
+{
+	log_verbose("Wayland: <%d> (init) loading Wayland support\n", m_id);
+
+	if (s_instance != nullptr)
+	{
+		log_error("Wayland: <%d> (init) [ERROR] only one Wayland backend instance is supported\n", m_id);
+		return false;
+	}
+
+	m_display = wl_display_connect(nullptr);
+	if (m_display == nullptr)
+	{
+		log_verbose("Wayland: <%d> (init) no Wayland compositor found\n", m_id);
+		return false;
+	}
+
+	s_instance = this;
+	m_registry = wl_display_get_registry(m_display);
+	wl_registry_add_listener(m_registry, &registry_listener, this);
+	wl_display_roundtrip(m_display);
+
+	if (m_manager == nullptr)
+	{
+		log_error("Wayland: <%d> (init) [ERROR] compositor doesn't support wlr-output-management\n", m_id);
+		return false;
+	}
+
+	// Wait for the initial head and mode description
+	while (!m_done)
+		if (wl_display_dispatch(m_display) < 0)
+			return false;
+
+	if (strcmp(m_device_name, "auto") && strcmp(m_device_name, ""))
+		m_head_name = m_device_name;
+
+	m_head = find_head();
+	if (m_head == nullptr)
+	{
+		log_error("Wayland: <%d> (init) [ERROR] no output matching '%s'\n", m_id, m_device_name);
+		return false;
+	}
+
+	log_info("Wayland: <%d> (init) output %s, protocol version %d, %s\n", m_id, m_head->name.c_str(), m_manager_version,
+		m_manager_version >= WAYLAND_TIMINGS_VERSION ? "custom timings supported" : "custom timings not supported, only advertised modes can be used");
+
+	return true;
+}
+
+//============================================================
+//  Event sinks
+//============================================================
+
+void wayland_timing::on_global(wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+	if (strcmp(interface, zwlr_output_manager_v1_interface.name) == 0)
+	{
+		m_manager_version = version < WAYLAND_MAX_VERSION ? version : WAYLAND_MAX_VERSION;
+		m_manager = (zwlr_output_manager_v1 *)wl_registry_bind(registry, name, &zwlr_output_manager_v1_interface, m_manager_version);
+		zwlr_output_manager_v1_add_listener(m_manager, &manager_listener, this);
+	}
+}
+
+void wayland_timing::on_head(zwlr_output_head_v1 *obj)
+{
+	wayland_head *head = new wayland_head();
+	head->obj = obj;
+	head->scale = 1.0;
+	m_heads.push_back(head);
+	zwlr_output_head_v1_add_listener(obj, &head_listener, head);
+}
+
+void wayland_timing::on_head_finished(wayland_head *head)
+{
+	for (auto mode : head->modes)
+	{
+		zwlr_output_mode_v1_destroy(mode->obj);
+		delete mode;
+	}
+	zwlr_output_head_v1_destroy(head->obj);
+
+	for (auto it = m_heads.begin(); it != m_heads.end(); ++it)
+		if (*it == head)
+		{
+			m_heads.erase(it);
+			break;
+		}
+
+	if (m_head == head)
+	{
+		log_error("Wayland: <%d> output %s disappeared\n", m_id, head->name.c_str());
+		m_head = nullptr;
+	}
+	delete head;
+}
+
+void wayland_timing::on_mode(wayland_head *head, zwlr_output_mode_v1 *obj)
+{
+	wayland_mode *mode = new wayland_mode();
+	mode->obj = obj;
+	mode->head = head;
+	head->modes.push_back(mode);
+	zwlr_output_mode_v1_add_listener(obj, &mode_listener, mode);
+}
+
+void wayland_timing::on_mode_finished(wayland_mode *mode)
+{
+	wayland_head *head = mode->head;
+	for (auto it = head->modes.begin(); it != head->modes.end(); ++it)
+		if (*it == mode)
+		{
+			head->modes.erase(it);
+			break;
+		}
+	if (head->current_mode == mode)
+		head->current_mode = nullptr;
+	zwlr_output_mode_v1_destroy(mode->obj);
+	delete mode;
+}
+
+void wayland_timing::on_done(uint32_t serial)
+{
+	m_serial = serial;
+	m_done = true;
+}
+
+void wayland_timing::on_config_result(int result)
+{
+	m_config_result = result;
+}
+
+//============================================================
+//  wayland_timing::sync
+//============================================================
+
+bool wayland_timing::sync()
+{
+	if (m_display == nullptr)
+		return false;
+
+	// Process any pending changes from the compositor
+	if (wl_display_roundtrip(m_display) < 0)
+	{
+		log_error("Wayland: <%d> [ERROR] lost connection to the compositor\n", m_id);
+		return false;
+	}
+
+	if (m_head == nullptr)
+		m_head = find_head();
+
+	return m_head != nullptr;
+}
+
+//============================================================
+//  wayland_timing::find_head
+//============================================================
+
+wayland_head *wayland_timing::find_head()
+{
+	// Explicit output: connector name or index
+	if (!m_head_name.empty())
+	{
+		char *end;
+		long index = strtol(m_head_name.c_str(), &end, 10);
+		if (*end == 0)
+			return (index >= 0 && index < (long)m_heads.size()) ? m_heads[index] : nullptr;
+
+		for (auto head : m_heads)
+			if (head->name == m_head_name)
+				return head;
+
+		return nullptr;
+	}
+
+	// Auto: first enabled output
+	for (auto head : m_heads)
+		if (head->enabled)
+			return head;
+
+	return nullptr;
+}
+
+//============================================================
+//  wayland_timing::find_mode
+//============================================================
+
+wayland_mode *wayland_timing::find_mode(modeline *mode)
+{
+	if (m_head == nullptr)
+		return nullptr;
+
+	if (m_manager_version >= WAYLAND_TIMINGS_VERSION)
+	{
+		wl_timings t;
+		modeline_to_timings(mode, &t);
+		for (auto m : m_head->modes)
+			if (m->has_timings && same_timings(&m->timings, &t))
+				return m;
+		return nullptr;
+	}
+
+	// No timings: only modes reported by get_timing can be matched, a
+	// calculated modeline (with a pixel clock) could otherwise match an
+	// advertised mode of the same size and refresh but different timings
+	if (mode->pclock != 0)
+		return nullptr;
+
+	for (auto m : m_head->modes)
+		if (m->width == mode->width && m->height == mode->height && (m->refresh + 500) / 1000 == mode->refresh)
+			return m;
+
+	return nullptr;
+}
+
+//============================================================
+//  wayland_timing::apply
+//============================================================
+
+bool wayland_timing::apply(modeline *mode, wayland_mode *existing)
+{
+	for (int attempt = 0; attempt < 3; attempt++)
+	{
+		zwlr_output_configuration_v1 *config = zwlr_output_manager_v1_create_configuration(m_manager, m_serial);
+		zwlr_output_configuration_v1_add_listener(config, &config_listener, this);
+
+		// Every head must be part of the configuration, untouched ones keep their state
+		for (auto head : m_heads)
+		{
+			if (head != m_head && !head->enabled)
+			{
+				zwlr_output_configuration_v1_disable_head(config, head->obj);
+				continue;
+			}
+
+			zwlr_output_configuration_head_v1 *config_head = zwlr_output_configuration_v1_enable_head(config, head->obj);
+			if (head != m_head)
+				continue;
+
+			if (existing != nullptr)
+				zwlr_output_configuration_head_v1_set_mode(config_head, existing->obj);
+			else
+			{
+				wl_timings t;
+				modeline_to_timings(mode, &t);
+				zwlr_output_configuration_head_v1_set_custom_timings(config_head, t.clock,
+					t.hdisplay, t.hsync_start, t.hsync_end, t.htotal,
+					t.vdisplay, t.vsync_start, t.vsync_end, t.vtotal, t.flags);
+			}
+		}
+
+		m_config_result = CONFIG_PENDING;
+		zwlr_output_configuration_v1_apply(config);
+
+		while (m_config_result == CONFIG_PENDING)
+			if (wl_display_dispatch(m_display) < 0)
+			{
+				zwlr_output_configuration_v1_destroy(config);
+				return false;
+			}
+
+		zwlr_output_configuration_v1_destroy(config);
+
+		if (m_config_result == CONFIG_SUCCEEDED)
+		{
+			// The new state, if any, is sent along with the result: a roundtrip
+			// is enough to get the new mode and current mode
+			return wl_display_roundtrip(m_display) >= 0;
+		}
+
+		if (m_config_result == CONFIG_FAILED)
+			return false;
+
+		// Cancelled: the output configuration changed meanwhile, retry with the new serial
+		log_verbose("Wayland: <%d> (apply) configuration cancelled, retrying\n", m_id);
+		wl_display_roundtrip(m_display);
+	}
+
+	return false;
+}
+
+//============================================================
+//  wayland_timing::add_mode
+//============================================================
+
+bool wayland_timing::add_mode(modeline *mode)
+{
+	// Modes are registered by the compositor when they're applied
+	return mode != nullptr;
+}
+
+//============================================================
+//  wayland_timing::delete_mode
+//============================================================
+
+bool wayland_timing::delete_mode(modeline *mode)
+{
+	// The compositor drops user modes on its own
+	return mode != nullptr;
+}
+
+//============================================================
+//  wayland_timing::update_mode
+//============================================================
+
+bool wayland_timing::update_mode(modeline *mode)
+{
+	return mode != nullptr;
+}
+
+//============================================================
+//  wayland_timing::set_timing
+//============================================================
+
+bool wayland_timing::set_timing(modeline *mode)
+{
+	if (mode == nullptr || mode->hactive == 0 || mode->vactive == 0)
+		return false;
+
+	if (!sync())
+		return false;
+
+	mode->type |= CUSTOM_VIDEO_TIMING_WAYLAND;
+
+	// Reuse an existing mode object if the compositor already knows these timings
+	wayland_mode *existing = find_mode(mode);
+
+	if (existing != nullptr && existing == m_head->current_mode)
+	{
+		log_verbose("Wayland: <%d> (set_timing) mode already active\n", m_id);
+		return true;
+	}
+
+	// Without timings, the compositor would pick its own timings for the size
+	// and refresh, possibly out of range for the monitor: only advertised modes
+	// are safe
+	if (existing == nullptr && m_manager_version < WAYLAND_TIMINGS_VERSION)
+	{
+		log_error("Wayland: <%d> (set_timing) [ERROR] the compositor doesn't support custom timings, can't set %dx%d%s %.3fHz\n",
+			m_id, mode->hactive, mode->vactive, mode->interlace ? "i" : "", mode->vfreq);
+		return false;
+	}
+
+	log_verbose("Wayland: <%d> (set_timing) %s %dx%d%s %.3fHz on %s\n", m_id, existing ? "selecting" : "setting",
+		mode->hactive, mode->vactive, mode->interlace ? "i" : "", mode->vfreq, m_head->name.c_str());
+
+	if (!apply(mode, existing))
+	{
+		log_error("Wayland: <%d> (set_timing) [ERROR] the compositor rejected the mode\n", m_id);
+		return false;
+	}
+
+	return true;
+}
+
+//============================================================
+//  wayland_timing::get_timing
+//============================================================
+
+bool wayland_timing::get_timing(modeline *mode)
+{
+	if (m_video_modes_position == 0 && !sync())
+		return false;
+
+	if (m_head == nullptr || m_video_modes_position >= m_head->modes.size())
+	{
+		// End of list
+		m_video_modes_position = 0;
+		return true;
+	}
+
+	wayland_mode *m = m_head->modes[m_video_modes_position++];
+	mode->platform_data = m_video_modes_position - 1;
+
+	if (m->has_timings)
+	{
+		const wl_timings *t = &m->timings;
+		mode->pclock     = (uint64_t)t->clock * 1000;
+		mode->hactive    = t->hdisplay;
+		mode->hbegin     = t->hsync_start;
+		mode->hend       = t->hsync_end;
+		mode->htotal     = t->htotal;
+		mode->vactive    = t->vdisplay;
+		mode->vbegin     = t->vsync_start;
+		mode->vend       = t->vsync_end;
+		mode->vtotal     = t->vtotal;
+		mode->interlace  = (t->flags & WL_FLAG_INTERLACE) ? 1 : 0;
+		mode->doublescan = (t->flags & WL_FLAG_DBLSCAN) ? 1 : 0;
+		mode->hsync      = (t->flags & WL_FLAG_PHSYNC) ? 1 : 0;
+		mode->vsync      = (t->flags & WL_FLAG_PVSYNC) ? 1 : 0;
+		mode->hfreq      = (double)mode->pclock / mode->htotal;
+		mode->vfreq      = mode->hfreq / mode->vtotal * (mode->interlace ? 2 : 1) / (mode->doublescan ? 2 : 1);
+	}
+	else
+	{
+		mode->hactive = m->width;
+		mode->vactive = m->height;
+		mode->vfreq   = m->refresh / 1000.0;
+	}
+
+	mode->width   = m->width;
+	mode->height  = m->height;
+	mode->refresh = (m->refresh + 500) / 1000;
+
+	mode->type |= CUSTOM_VIDEO_TIMING_WAYLAND;
+	if (m == m_head->current_mode)
+		mode->type |= MODE_DESKTOP;
+
+	return true;
+}
diff --git a/custom_video_wayland.h b/custom_video_wayland.h
new file mode 100644
index 0000000..6e57afb
--- /dev/null
+++ b/custom_video_wayland.h
@@ -0,0 +1,111 @@
+/**************************************************************
+
+   custom_video_wayland.h - Linux Wayland video management layer
+
+   ---------------------------------------------------------
+
+   Switchres   Modeline generation engine for emulation
+
+   License     GPL-2.0+
+   Copyright   2010-2021 Chris Kennedy, Antonio Giner,
+                         Alexandre Wodarczyk, Gil Delescluse
+
+ **************************************************************/
+
+#ifndef __CUSTOM_VIDEO_WAYLAND__
+#define __CUSTOM_VIDEO_WAYLAND__
+
+#include <vector>
+#include <string>
+#include "custom_video.h"
+
+struct wl_display;
+struct wl_registry;
+struct zwlr_output_manager_v1;
+struct zwlr_output_head_v1;
+struct zwlr_output_mode_v1;
+
+// Detailed timings as exchanged with the compositor, DRM units (kHz, DRM_MODE_FLAG_*)
+typedef struct wl_timings
+{
+	uint32_t clock;
+	uint32_t hdisplay, hsync_start, hsync_end, htotal;
+	uint32_t vdisplay, vsync_start, vsync_end, vtotal;
+	uint32_t flags;
+} wl_timings;
+
+struct wayland_head;
+
+typedef struct wayland_mode
+{
+	zwlr_output_mode_v1 *obj;
+	wayland_head *head;
+	int width, height;
+	int refresh; // mHz
+	bool preferred;
+	bool has_timings;
+	wl_timings timings;
+} wayland_mode;
+
+typedef struct wayland_head
+{
+	zwlr_output_head_v1 *obj;
+	std::string name;
+	bool enabled;
+	int x, y;
+	int transform;
+	double scale;
+	wayland_mode *current_mode;
+	std::vector<wayland_mode *> modes;
+} wayland_head;
+
+class wayland_timing : public custom_video
+{
+	public:
+		wayland_timing(char *device_name, custom_video_settings *vs);
+		~wayland_timing();
+		const char *api_name() { return "WAYLAND"; }
+		int caps() { return CUSTOM_VIDEO_CAPS_ADD; }
+		bool init();
+
+		bool add_mode(modeline *mode);
+		bool delete_mode(modeline *mode);
+		bool update_mode(modeline *mode);
+
+		bool get_timing(modeline *mode);
+		bool set_timing(modeline *mode);
+
+		// Protocol event sinks, public for the C listeners
+		void on_global(wl_registry *registry, uint32_t name, const char *interface, uint32_t version);
+		void on_head(zwlr_output_head_v1 *obj);
+		void on_head_finished(wayland_head *head);
+		void on_mode(wayland_head *head, zwlr_output_mode_v1 *obj);
+		void on_mode_finished(wayland_mode *mode);
+		void on_done(uint32_t serial);
+		void on_config_result(int result);
+
+	private:
+		int m_id = 0;
+		char m_device_name[32];
+
+		wl_display *m_display = nullptr;
+		wl_registry *m_registry = nullptr;
+		zwlr_output_manager_v1 *m_manager = nullptr;
+		uint32_t m_manager_version = 0;
+		uint32_t m_serial = 0;
+		bool m_done = false;
+		int m_config_result = 0;
+
+		std::vector<wayland_head *> m_heads;
+		wayland_head *m_head = nullptr;
+		std::string m_head_name;
+
+		size_t m_video_modes_position = 0;
+
+		bool sync();
+		wayland_head *find_head();
+		wayland_mode *find_mode(modeline *mode);
+		bool apply(modeline *mode, wayland_mode *existing);
+};
+
+#endif
