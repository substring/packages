@@ -0,0 +1,236 @@
+/**************************************************************
+
+   drm_lease.cpp - DRM lease through wp-drm-lease-v1
+
+   ---------------------------------------------------------
+
+   Switchres   Modeline generation engine for emulation
+
+   License     GPL-2.0+
+   Copyright   2010-2021 Chris Kennedy, Antonio Giner,
+                         Alexandre Wodarczyk, Gil Delescluse
+
+ **************************************************************/
+
+// Under a Wayland compositor, the compositor is the DRM master of the device:
+// opening the device gives no modesetting rights. A compositor implementing
+// wp-drm-lease-v1 can lease a connector instead (labwc leases any output, the
+// one of its desktop included), handing a DRM fd to which the DRM/KMS backend
+// is applied as is.
+
+#include <string.h>
+#include <unistd.h>
+#include <wayland-client.h>
+#include "drm-lease-v1-client-protocol.h"
+#include "drm_lease.h"
+#include "log.h"
+
+//============================================================
+//  Event sinks
+//============================================================
+
+static void connector_name(void *data, struct wp_drm_lease_connector_v1 *, const char *name)
+{
+	((drm_lease::connector *)data)->name = name;
+}
+
+static void connector_description(void *, struct wp_drm_lease_connector_v1 *, const char *) {}
+static void connector_id(void *, struct wp_drm_lease_connector_v1 *, uint32_t) {}
+static void connector_done(void *, struct wp_drm_lease_connector_v1 *) {}
+
+static void connector_withdrawn(void *data, struct wp_drm_lease_connector_v1 *)
+{
+	((drm_lease::connector *)data)->withdrawn = true;
+}
+
+static const struct wp_drm_lease_connector_v1_listener connector_listener =
+{
+	connector_name, connector_description, connector_id, connector_done, connector_withdrawn
+};
+
+static void device_drm_fd(void *, struct wp_drm_lease_device_v1 *, int fd)
+{
+	// Non-master fd of the device, not needed: the lease fd is enough
+	close(fd);
+}
+
+static void device_connector(void *data, struct wp_drm_lease_device_v1 *, struct wp_drm_lease_connector_v1 *obj)
+{
+	drm_lease::device *dev = (drm_lease::device *)data;
+	drm_lease::connector *conn = new drm_lease::connector { dev, obj, "", false };
+	dev->lease->m_connectors.push_back(conn);
+	wp_drm_lease_connector_v1_add_listener(obj, &connector_listener, conn);
+}
+
+static void device_done(void *data, struct wp_drm_lease_device_v1 *)
+{
+	((drm_lease::device *)data)->done = true;
+}
+
+static void device_released(void *, struct wp_drm_lease_device_v1 *) {}
+
+static const struct wp_drm_lease_device_v1_listener device_listener =
+{
+	device_drm_fd, device_connector, device_done, device_released
+};
+
+static void lease_fd(void *data, struct wp_drm_lease_v1 *, int fd)
+{
+	((drm_lease *)data)->m_fd = fd;
+}
+
+static void lease_finished(void *data, struct wp_drm_lease_v1 *)
+{
+	((drm_lease *)data)->m_finished = true;
+}
+
+static const struct wp_drm_lease_v1_listener lease_listener = { lease_fd, lease_finished };
+
+static void registry_global(void *data, struct wl_registry *registry, uint32_t name, const char *interface, uint32_t)
+{
+	drm_lease *lease = (drm_lease *)data;
+	if (strcmp(interface, wp_drm_lease_device_v1_interface.name))
+		return;
+
+	drm_lease::device *dev = new drm_lease::device { lease, nullptr, false };
+	dev->obj = (struct wp_drm_lease_device_v1 *)wl_registry_bind(registry, name, &wp_drm_lease_device_v1_interface, 1);
+	wp_drm_lease_device_v1_add_listener(dev->obj, &device_listener, dev);
+	lease->m_devices.push_back(dev);
+}
+
+static void registry_global_remove(void *, struct wl_registry *, uint32_t) {}
+
+static const struct wl_registry_listener registry_listener = { registry_global, registry_global_remove };
+
+//============================================================
+//  drm_lease::acquire
+//============================================================
+
+int drm_lease::acquire(const char *name)
+{
+	release();
+
+	m_display = wl_display_connect(NULL);
+	if (m_display == nullptr)
+	{
+		log_error("DRM lease: [ERROR] can't connect to the Wayland compositor\n");
+		return -1;
+	}
+
+	m_registry = wl_display_get_registry(m_display);
+	wl_registry_add_listener(m_registry, &registry_listener, this);
+
+	// Globals, then the connectors of each lease device
+	if (wl_display_roundtrip(m_display) < 0 || wl_display_roundtrip(m_display) < 0)
+	{
+		release();
+		return -1;
+	}
+
+	if (m_devices.empty())
+	{
+		log_error("DRM lease: [ERROR] the compositor doesn't support wp-drm-lease-v1\n");
+		release();
+		return -1;
+	}
+
+	connector *target = nullptr;
+	bool any = name == nullptr || !strcmp(name, "") || !strcmp(name, "auto");
+	for (auto conn : m_connectors)
+	{
+		log_verbose("DRM lease: connector %s offered%s\n", conn->name.c_str(), conn->withdrawn ? " (withdrawn)" : "");
+		if (target == nullptr && !conn->withdrawn && (any || conn->name == name))
+			target = conn;
+	}
+
+	if (target == nullptr)
+	{
+		log_error("DRM lease: [ERROR] no connector %s to lease\n", any ? "" : name);
+		release();
+		return -1;
+	}
+
+	struct wp_drm_lease_request_v1 *request = wp_drm_lease_device_v1_create_lease_request(target->dev->obj);
+	wp_drm_lease_request_v1_request_connector(request, target->obj);
+	m_lease = wp_drm_lease_request_v1_submit(request);
+	wp_drm_lease_v1_add_listener(m_lease, &lease_listener, this);
+
+	while (m_fd < 0 && !m_finished)
+		if (wl_display_dispatch(m_display) < 0)
+			break;
+
+	if (m_fd < 0)
+	{
+		log_error("DRM lease: [ERROR] the compositor refused to lease %s\n", target->name.c_str());
+		release();
+		return -1;
+	}
+
+	m_connector_name = target->name;
+	log_info("DRM lease: %s leased, fd %d\n", m_connector_name.c_str(), m_fd);
+	return m_fd;
+}
+
+//============================================================
+//  drm_lease::revoked
+//============================================================
+
+bool drm_lease::revoked()
+{
+	if (m_display != nullptr && !m_finished)
+	{
+		wl_display_dispatch_pending(m_display);
+		wl_display_flush(m_display);
+	}
+	return m_finished;
+}
+
+//============================================================
+//  drm_lease::release
+//============================================================
+
+void drm_lease::release()
+{
+	// The lease ends with the destruction of its object, the compositor takes
+	// the connector back. The fd itself belongs to the DRM backend.
+	if (m_lease != nullptr)
+		wp_drm_lease_v1_destroy(m_lease);
+	m_lease = nullptr;
+
+	// Release the devices, which may still send events until the compositor
+	// answers with released: their data must outlive the roundtrip
+	for (auto dev : m_devices)
+		wp_drm_lease_device_v1_release(dev->obj);
+
+	if (m_display != nullptr)
+		wl_display_roundtrip(m_display);
+
+	for (auto conn : m_connectors)
+	{
+		wp_drm_lease_connector_v1_destroy(conn->obj);
+		delete conn;
+	}
+	m_connectors.clear();
+
+	for (auto dev : m_devices)
+	{
+		wp_drm_lease_device_v1_destroy(dev->obj);
+		delete dev;
+	}
+	m_devices.clear();
+
+	if (m_registry != nullptr)
+		wl_registry_destroy(m_registry);
+	m_registry = nullptr;
+
+	if (m_display != nullptr)
+	{
+		wl_display_flush(m_display);
+		wl_display_disconnect(m_display);
+	}
+	m_display = nullptr;
+
+	m_fd = -1;
+	m_finished = false;
+	m_connector_name.clear();
+}
diff --git a/drm_lease.h b/drm_lease.h
new file mode 100644
index 0000000..009c2a4
--- /dev/null
+++ b/drm_lease.h
@@ -0,0 +1,72 @@
+/**************************************************************
+
+   drm_lease.h - DRM lease through wp-drm-lease-v1
+
+   ---------------------------------------------------------
+
+   Switchres   Modeline generation engine for emulation
+
+   License     GPL-2.0+
+   Copyright   2010-2021 Chris Kennedy, Antonio Giner,
+                         Alexandre Wodarczyk, Gil Delescluse
+
+ **************************************************************/
+
+#ifndef __DRM_LEASE__
+#define __DRM_LEASE__
+
+#include <string>
+#include <vector>
+
+struct wl_display;
+struct wl_registry;
+struct wp_drm_lease_device_v1;
+struct wp_drm_lease_connector_v1;
+struct wp_drm_lease_v1;
+
+// Leases a connector from the Wayland compositor. The lease fd is a DRM fd
+// which is master over the leased connector, its CRTC and its plane only: it
+// is used like a DRM device fd opened as master, without being master of the
+// whole device. The lease lasts until release() or until the compositor
+// revokes it.
+class drm_lease
+{
+	public:
+		drm_lease() {};
+		~drm_lease() { release(); };
+
+		// Lease the connector of this name ("auto" or "": the first offered).
+		// Returns the lease fd, or -1.
+		int acquire(const char *connector_name);
+		void release();
+
+		bool revoked();
+		const char *connector_name() { return m_connector_name.c_str(); }
+
+		// Event sinks
+		struct device
+		{
+			drm_lease *lease;
+			struct wp_drm_lease_device_v1 *obj;
+			bool done;
+		};
+		struct connector
+		{
+			device *dev;
+			struct wp_drm_lease_connector_v1 *obj;
+			std::string name;
+			bool withdrawn;
+		};
+		std::vector<device *> m_devices;
+		std::vector<connector *> m_connectors;
+		int m_fd = -1;
+		bool m_finished = false;
+
+	private:
+		struct wl_display *m_display = nullptr;
+		struct wl_registry *m_registry = nullptr;
+		struct wp_drm_lease_v1 *m_lease = nullptr;
+		std::string m_connector_name;
+};
+
+#endif
