From 84c18eb01ae08283d90aa599b0e793e9a4bea037 Mon Sep 17 00:00:00 2001
From: Substring <frog2wah@gmail.com>
Date: Sat, 3 Oct 2026 00:43:25 +0200
Subject: [PATCH 33/40] libretro: destroy the hardware context before unloading
 the game, like RetroArch

LRPS2 pauses its CPU thread in context_destroy and spins until it is paused; after retro_unload_game the thread is already stopped, so exiting hung forever with Shadow of the Colossus.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mame/libretro/libretro.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/mame/libretro/libretro.cpp b/src/mame/libretro/libretro.cpp
index b0355f7c93b..9fec56ce7a4 100644
--- a/src/mame/libretro/libretro.cpp
+++ b/src/mame/libretro/libretro.cpp
@@ -1509,9 +1509,11 @@ void libretro_state::machine_exit()
 	m_loaded = false;
 	{
 		libretro_gl_scope scope(m_gl.get());
-		m_api.unload_game();
+		// the context goes before the game, like RetroArch: LRPS2 pauses its
+		// CPU thread in context_destroy and waits forever once it's stopped
 		if (m_gl && m_hw.context_destroy)
 			m_hw.context_destroy();
+		m_api.unload_game();
 		m_api.deinit();
 	}
 	m_gl.reset();
-- 
2.53.0


