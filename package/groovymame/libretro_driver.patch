From 4a8b8eed4a850b71b2f0789d9b0574512e4cd75b Mon Sep 17 00:00:00 2001
From: Substring <frog2wah@gmail.com>
Date: Mon, 28 Sep 2026 11:58:52 +0200
Subject: [PATCH 16/40] libretro: let cores change their own options with
 SET_VARIABLE

The value must be one the option accepts; the change is reported to the core through GET_VARIABLE_UPDATE and saved in the core options file.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mame/libretro/libretro.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/mame/libretro/libretro.cpp b/src/mame/libretro/libretro.cpp
index fb870ce2636..769fc97e6db 100644
--- a/src/mame/libretro/libretro.cpp
+++ b/src/mame/libretro/libretro.cpp
@@ -896,6 +896,27 @@ bool libretro_state::environment(unsigned cmd, void *data)
 		return true;
 	}
 
+	case RETRO_ENVIRONMENT_SET_VARIABLE:
+	{
+		// the core changes one of its own options, NULL asks if supported
+		auto *var = reinterpret_cast<const retro_variable *>(data);
+		if (!var)
+			return true;
+
+		option *const opt = (var->key && var->value && *var->value) ? find_option(var->key) : nullptr;
+		if (!opt || (!opt->values.empty() && std::none_of(opt->values.begin(), opt->values.end(), [var] (const auto &v) { return v.first == var->value; })))
+			return false;
+
+		m_option_values[opt->key] = var->value;
+		apply_option_value(*opt);
+		m_options_updated = true;
+
+		// the file name is only known once the core is identified
+		if (!m_library_name.empty())
+			save_options();
+		return true;
+	}
+
 	case RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE:
 		*reinterpret_cast<bool *>(data) = std::exchange(m_options_updated, false);
 		return true;
-- 
2.53.0


From c2e737165e88abe045f32a17da28c2992cd28c11 Mon Sep 17 00:00:00 2001
From: Substring <frog2wah@gmail.com>
Date: Mon, 28 Sep 2026 11:59:45 +0200
Subject: [PATCH 17/40] libretro: fix the first core option lost on reload

The core options file was written with a UTF-8 BOM, which became part of the first key when reading it back, so that option went back to its default. Write it without BOM, as RetroArch does, and skip a BOM when reading files written before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mame/libretro/libretro.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

