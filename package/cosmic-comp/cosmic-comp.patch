diff --git a/cosmic-comp-config/src/output/comp.rs b/cosmic-comp-config/src/output/comp.rs
index 1810b9d4..723fdc75 100644
--- a/cosmic-comp-config/src/output/comp.rs
+++ b/cosmic-comp-config/src/output/comp.rs
@@ -51,6 +51,69 @@ pub struct OutputConfig {
     pub max_bpc: Option<u32>,
     #[serde(default)]
     pub xwayland_primary: bool,
+    /// Exact timings of a custom mode, set through wlr-output-management v5.
+    /// Custom modes are not saved, like with xrandr: `fallback_mode` is saved
+    /// instead, so a restart never picks a mode of the same size with other
+    /// timings, which could be out of range for the monitor.
+    #[serde(skip)]
+    pub modeline: Option<Modeline>,
+    /// Last mode which isn't custom
+    #[serde(skip)]
+    pub fallback_mode: Option<((i32, i32), Option<u32>)>,
+}
+
+impl OutputConfig {
+    /// The configuration to save
+    pub fn saved(&self) -> OutputConfig {
+        let mut config = self.clone();
+        if config.modeline.take().is_some() {
+            config.mode = config.fallback_mode.unwrap_or(config.mode);
+        }
+        config.fallback_mode = None;
+        config
+    }
+}
+
+/// Mode timings, in DRM units (kHz, DRM_MODE_FLAG_*)
+#[derive(Debug, Deserialize, Serialize, Clone, PartialEq, Eq, Hash)]
+pub struct Modeline {
+    pub name: String,
+    pub clock: u32,
+    pub hdisplay: u16,
+    pub hsync_start: u16,
+    pub hsync_end: u16,
+    pub htotal: u16,
+    pub vdisplay: u16,
+    pub vsync_start: u16,
+    pub vsync_end: u16,
+    pub vtotal: u16,
+    pub flags: u32,
+}
+
+impl Modeline {
+    const FLAG_INTERLACE: u32 = 0x10;
+    const FLAG_DBLSCAN: u32 = 0x20;
+
+    /// Refresh rate in mHz, computed like the DRM backend does
+    pub fn refresh(&self) -> u32 {
+        let (htotal, vtotal) = (self.htotal as u64, self.vtotal as u64);
+        if htotal == 0 || vtotal == 0 {
+            return 0;
+        }
+        let mut refresh = (self.clock as u64 * 1_000_000 / htotal + vtotal / 2) / vtotal;
+        if self.flags & Self::FLAG_INTERLACE != 0 {
+            refresh *= 2;
+        }
+        if self.flags & Self::FLAG_DBLSCAN != 0 {
+            refresh /= 2;
+        }
+        refresh as u32
+    }
+
+    /// Timings with the same meaning, the name aside
+    pub fn same_timings(&self, other: &Modeline) -> bool {
+        Modeline { name: String::new(), ..self.clone() } == Modeline { name: String::new(), ..other.clone() }
+    }
 }
 
 impl Default for OutputConfig {
@@ -64,6 +127,8 @@ impl Default for OutputConfig {
             enabled: OutputState::Enabled,
             max_bpc: None,
             xwayland_primary: false,
+            modeline: None,
+            fallback_mode: None,
         }
     }
 }
