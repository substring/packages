From 59e52025b214e9674fcb0d83f0d5bd7bfbcd7c26 Mon Sep 17 00:00:00 2001
From: Substring <frog2wah@gmail.com>
Date: Mon, 19 Oct 2026 21:19:27 +0200
Subject: [PATCH 2/3] shell: resize fullscreen windows with their output

Workspace::recalculate(), called after an output configuration change,
only lays out the tiling and floating layers: a fullscreen window kept
the size of the mode it went fullscreen on. After a mode change, an
emulator kept drawing at the former size, cropped or misplaced in the
new mode.

Reconfigure the fullscreen windows to the output geometry as well.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/shell/workspace.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/shell/workspace.rs b/src/shell/workspace.rs
index fd63dcb1..18b2b860 100644
--- a/src/shell/workspace.rs
+++ b/src/shell/workspace.rs
@@ -997,6 +997,13 @@ impl Workspace {
     pub fn recalculate(&mut self) {
         self.tiling_layer.recalculate();
         self.floating_layer.recalculate();
+
+        // Fullscreen windows follow the size of the output, e.g. on a mode change
+        let geometry = self.output.geometry();
+        for fullscreen in self.fullscreen_surfaces.iter().filter(|f| f.ended_at.is_none()) {
+            fullscreen.surface.set_geometry(geometry, 0);
+            fullscreen.surface.send_configure();
+        }
     }
 
     pub fn unmaximize_request(&mut self, elem: &CosmicMapped) -> Option<Rectangle<i32, Local>> {

From 3d10ba7ac3e6810f39b80f9b341ebf37cb15ac5b Mon Sep 17 00:00:00 2001
From: Substring <frog2wah@gmail.com>
Date: Mon, 19 Oct 2026 22:56:05 +0200
Subject: [PATCH 3/3] kms/timings: fix the next presentation estimate on an
 early VBlank

next_presentation_time() returns the time until the next presentation.
On an early VBlank, when the presentation timestamp of the last frame is
still in the future, it shifts now by one refresh interval to count the
elapsed intervals, but then subtracts that shifted now from the
estimate: the next presentation is predicted one refresh interval too
early.

The DRM timestamp of a page flip is the end of the vblank, so the
VBlank event is always early when it is handled within the vblank, and
more so with long vblanks (15 kHz CRT modes). Frames were then either
rendered right away or one interval later, depending on whether the
client commit came before or after the timestamp: frame callbacks
alternated between two phases and vblanks were missed, especially with
deep CPU C-states.

Subtract the actual time.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/backend/kms/surface/timings.rs | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/backend/kms/surface/timings.rs b/src/backend/kms/surface/timings.rs
index d2bc5efa..0751697a 100644
--- a/src/backend/kms/surface/timings.rs
+++ b/src/backend/kms/surface/timings.rs
@@ -280,7 +280,8 @@ impl Timings {
     }
 
     pub fn next_presentation_time(&self, clock: &Clock<Monotonic>) -> Duration {
-        let mut now = clock.now().into();
+        let orig_now: Duration = clock.now().into();
+        let mut now = orig_now;
 
         let Some(refresh_interval_ns) = self.refresh_interval_ns else {
             return Duration::ZERO;
@@ -296,7 +297,6 @@ impl Timings {
 
         if now <= last_presentation_time {
             // Got an early VBlank.
-            let orig_now = now;
             now += Duration::from_nanos(refresh_interval_ns);
 
             if now < last_presentation_time {
@@ -321,7 +321,9 @@ impl Timings {
         if self.vrr && to_next_ns > refresh_interval_ns {
             Duration::ZERO
         } else {
-            last_presentation_time + Duration::from_nanos(to_next_ns) - now
+            // From the actual time: the shifted `now` of an early VBlank would put the
+            // estimate one refresh interval early
+            (last_presentation_time + Duration::from_nanos(to_next_ns)).saturating_sub(orig_now)
         }
     }
 
