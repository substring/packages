+/// Builds a DRM mode from custom timings
+pub fn modeline_to_mode(timings: &cosmic_comp_config::output::comp::Modeline) -> Mode {
+    let mut name = [0 as core::ffi::c_char; 32];
+    for (dst, src) in name.iter_mut().zip(timings.name.bytes().take(31)) {
+        *dst = src as core::ffi::c_char;
+    }
+    let raw = drm_ffi::drm_mode_modeinfo {
+        clock: timings.clock,
+        hdisplay: timings.hdisplay,
+        hsync_start: timings.hsync_start,
+        hsync_end: timings.hsync_end,
+        htotal: timings.htotal,
+        hskew: 0,
+        vdisplay: timings.vdisplay,
+        vsync_start: timings.vsync_start,
+        vsync_end: timings.vsync_end,
+        vtotal: timings.vtotal,
+        vscan: 0,
+        vrefresh: (timings.refresh() + 500) / 1000,
+        flags: timings.flags,
+        type_: drm_ffi::DRM_MODE_TYPE_USERDEF,
+        name,
+    };
+    Mode::from(raw)
+}
+
+/// Timings of a DRM mode
+pub fn mode_to_modeline(mode: &Mode) -> cosmic_comp_config::output::comp::Modeline {
+    let (hdisplay, vdisplay) = mode.size();
+    let (hsync_start, hsync_end, htotal) = mode.hsync();
+    let (vsync_start, vsync_end, vtotal) = mode.vsync();
+    cosmic_comp_config::output::comp::Modeline {
+        name: mode.name().to_string_lossy().into_owned(),
+        clock: mode.clock(),
+        hdisplay,
+        hsync_start,
+        hsync_end,
+        htotal,
+        vdisplay,
+        vsync_start,
+        vsync_end,
+        vtotal,
+        flags: mode.flags().bits(),
+    }
+}
