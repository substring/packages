Date: Sun, 18 Oct 2026 21:58:38 +0200
Subject: [PATCH 5/8] backend/drm: keep interlaced modes

Interlaced modes were skipped because they couldn't be told from
progressive ones by size and refresh rate (sway#3167). Modes now have
an interlaced flag: keep interlaced modes, after the progressive ones,
so that a lookup by size and refresh rate still picks the progressive
mode when both exist.

Displays which only support interlaced modes, such as 15 kHz CRT
monitors and TVs, had no mode at all.

Also match the current mode by its timings, as the mode read from the
CRTC may differ from the connector's one in name or type.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 backend/drm/drm.c | 34 ++++++++++++++++++++++++++--------
 1 file changed, 26 insertions(+), 8 deletions(-)

diff --git a/backend/drm/drm.c b/backend/drm/drm.c
index 79d6db8..ddf9a87 100644
--- a/backend/drm/drm.c
+++ b/backend/drm/drm.c
@@ -1072,6 +1072,17 @@ static bool drm_connector_alloc_crtc(struct wlr_drm_connector *conn) {
 	return ok;
 }
 
+// Same timings, regardless of the name and type of the modes
+static bool drm_mode_timings_equal(const drmModeModeInfo *a, const drmModeModeInfo *b) {
+	return a->clock == b->clock &&
+		a->hdisplay == b->hdisplay && a->hsync_start == b->hsync_start &&
+		a->hsync_end == b->hsync_end && a->htotal == b->htotal &&
+		a->hskew == b->hskew &&
+		a->vdisplay == b->vdisplay && a->vsync_start == b->vsync_start &&
+		a->vsync_end == b->vsync_end && a->vtotal == b->vtotal &&
+		a->vscan == b->vscan && a->flags == b->flags;
+}
+
 static struct wlr_drm_mode *drm_mode_create(const drmModeModeInfo *modeinfo) {
 	struct wlr_drm_mode *mode = calloc(1, sizeof(*mode));
 	if (!mode) {
@@ -1673,12 +1684,13 @@ static bool connect_drm_connector(struct wlr_drm_connector *wlr_conn,
 
 	wlr_log(WLR_INFO, "Detected modes:");
 
+	// Interlaced modes come after progressive ones, so that looking up a mode
+	// by size and refresh rate picks the progressive one when both exist
+	struct wl_list interlaced_modes;
+	wl_list_init(&interlaced_modes);
+
 	bool found_current_mode = false;
 	for (int i = 0; i < drm_conn->count_modes; ++i) {
-		if (drm_conn->modes[i].flags & DRM_MODE_FLAG_INTERLACE) {
-			continue;
-		}
-
 		struct wlr_drm_mode *mode = drm_mode_create(&drm_conn->modes[i]);
 		if (!mode) {
 			wlr_log_errno(WLR_ERROR, "Allocation failed");
@@ -1689,19 +1701,25 @@ static bool connect_drm_connector(struct wlr_drm_connector *wlr_conn,
 
 		// If this is the current mode set on the conn's crtc,
 		// then set it as the conn's output current mode.
-		if (current_modeinfo != NULL && memcmp(&mode->drm_mode,
-				current_modeinfo, sizeof(*current_modeinfo)) == 0) {
+		if (current_modeinfo != NULL && !found_current_mode &&
+				drm_mode_timings_equal(&mode->drm_mode, current_modeinfo)) {
 			wlr_output_state_set_mode(&state, &mode->wlr_mode);
 			found_current_mode = true;
 		}
 
-		wlr_log(WLR_INFO, "  %"PRId32"x%"PRId32" @ %.3f Hz %s",
+		wlr_log(WLR_INFO, "  %"PRId32"x%"PRId32"%s @ %.3f Hz %s",
 			mode->wlr_mode.width, mode->wlr_mode.height,
+			mode->wlr_mode.interlaced ? "i" : "",
 			(float)mode->wlr_mode.refresh / 1000,
 			mode->wlr_mode.preferred ? "(preferred)" : "");
 
-		wl_list_insert(modes.prev, &mode->wlr_mode.link);
+		if (mode->wlr_mode.interlaced) {
+			wl_list_insert(interlaced_modes.prev, &mode->wlr_mode.link);
+		} else {
+			wl_list_insert(modes.prev, &mode->wlr_mode.link);
+		}
 	}
+	wl_list_insert_list(modes.prev, &interlaced_modes);
 
 	if (current_modeinfo != NULL) {
 		int32_t refresh = calculate_refresh_rate(current_modeinfo);

From 402700d61eb931686c374d2696aeb4835d55eff3 Mon Sep 17 00:00:00 2001
From: Substring <frog2wah@gmail.com>
Date: Sun, 18 Oct 2026 21:58:50 +0200
Subject: [PATCH 6/8] backend/drm: keep the timings of the current mode

When the mode set on the CRTC wasn't among the connector's modes, it
was kept as a custom mode, i.e. width, height and refresh rate only,
and regenerated as a CVT mode on the next modeset. CVT timings can be
out of range for the display: a 640x480i mode at 15 kHz became a
640x480 one at 31 kHz, which a 15 kHz CRT monitor can't handle.

Add the mode in use to the output modes instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 backend/drm/drm.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/backend/drm/drm.c b/backend/drm/drm.c
index ddf9a87..b8f8e65 100644
--- a/backend/drm/drm.c
+++ b/backend/drm/drm.c
@@ -1725,8 +1725,22 @@ static bool connect_drm_connector(struct wlr_drm_connector *wlr_conn,
 		int32_t refresh = calculate_refresh_rate(current_modeinfo);
 
 		if (!found_current_mode) {
-			wlr_output_state_set_custom_mode(&state,
-				current_modeinfo->hdisplay, current_modeinfo->vdisplay, refresh);
+			// Keep the exact timings of the mode in use: a custom mode would
+			// be regenerated as a CVT mode on the next modeset, which may be
+			// out of range for the display
+			struct wlr_drm_mode *mode = drm_mode_create(current_modeinfo);
+			if (mode != NULL) {
+				mode->wlr_mode.preferred = false;
+				wlr_log(WLR_INFO, "  %"PRId32"x%"PRId32"%s @ %.3f Hz (current, not advertised)",
+					mode->wlr_mode.width, mode->wlr_mode.height,
+					mode->wlr_mode.interlaced ? "i" : "",
+					(float)mode->wlr_mode.refresh / 1000);
+				wl_list_insert(modes.prev, &mode->wlr_mode.link);
+				wlr_output_state_set_mode(&state, &mode->wlr_mode);
+			} else {
+				wlr_output_state_set_custom_mode(&state,
+					current_modeinfo->hdisplay, current_modeinfo->vdisplay, refresh);
+			}
 		}
 
 		uint64_t mode_id = 0;

